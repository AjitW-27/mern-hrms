VITE_API_URL=http://localhost:5000/api
# Optional TURN/STUN server list for production WebRTC. JSON array of RTCIceServer objects.
# Example: VITE_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"...","credential":"..."}]
VITE_ICE_SERVERS=[]
# Vite development proxy target (only used by npm run dev)
VITE_DEV_API_TARGET=http://localhost:5000
