# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/hrms_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRE=30d

# Email (Nodemailer - Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME=HRMS System

# Biometric Device
BIOMETRIC_IP=192.168.1.201
BIOMETRIC_PORT=4370

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Company Info
COMPANY_NAME=Your Company Name
COMPANY_TIMEZONE=Asia/Kolkata

# Biometric reconnect retry interval (15 minutes default)
BIOMETRIC_RECONNECT_INTERVAL_MS=900000
HOST=0.0.0.0

# Optional AI assistant. Never put these credentials in VITE_* variables.
# No key: deterministic local answers from authorized HRMS data remain enabled.
AI_ASSISTANT_ENABLED=true
# Supported provider for the existing integration:
AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional model override; OPENAI_MODEL remains supported for compatibility.
AI_MODEL=gpt-4.1-mini
AI_RATE_LIMIT_MAX=20

# Google OAuth Web application credentials; register CLIENT_URL as an authorized JavaScript origin.
# Only the public client ID is returned to the browser. Keep the secret on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
